# Copy to .env.local to change defaults. No secrets are needed for the demo.

# "mock" = in-process Opus simulator (demo). "opus" = real Opus (not built yet; see README "Real Opus integration").
DATA_MODE=mock

# Delay (ms) of simulated asynchronous Opus steps: AI pre-check and job posting.
SIM_DELAY_MS=2500

# Show the mockup's "Data sources" toggle in the app bar (labels each panel with where its data comes from).
NEXT_PUBLIC_SHOW_SOURCES=false

# Placeholders for the real integration (server-side only, never exposed to the browser).
OPUS_BASE_URL=https://operator.opus.com
OPUS_SERVICE_KEY=
OPUS_WEBHOOK_SECRET=

# Opus "Create Requisition" workflow (spec 01). With OPUS_SERVICE_KEY and this both set, submitting a
# requisition creates an Opus case first; if Opus fails, the requisition is not submitted.
# Both unset = off (submit works without Opus). Only one set = submit fails with "not set up".
OPUS_CREATE_REQUISITION_WORKFLOW_ID=

# Optional: persist the demo store in Upstash Redis (needed on Vercel, where instances don't share memory).
# The Vercel Marketplace Upstash integration sets these automatically. Unset = in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
